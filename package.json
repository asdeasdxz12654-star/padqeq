{
  "name": "haedam",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-wasm.mjs && next dev",
    "build": "node scripts/copy-wasm.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:types": "wrangler types --env-interface CloudflareEnv --include-runtime false cloudflare-env.d.ts",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked > src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@jsquash/avif": "2.1.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "exifr": "7.1.3",
    "leaflet": "1.9.4",
    "libheif-js": "^1.23.5",
    "libraw-wasm": "1.6.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "@electric-sql/pglite": "^0.5.8",
    "@opennextjs/cloudflare": "^1.20.10",
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "1.9.22",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "supabase": "^2.120.0",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  }
}
