{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "haedam",
  // OpenNext가 만든 Next 앱을 worker.ts가 감싼다 (CSP · 세션 갱신 · 예약 작업)
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // 서버(Worker)를 DB(Supabase)와 가까운 곳에서 돌린다: 화면 하나에 DB를 여러 번 묻는 경우 왕복 시간이 줄어든다
  "placement": { "mode": "smart" },
  // 대표 주소는 SITE_HOST. workers.dev 주소는 남겨 두되 worker.ts가 대표 주소로 넘긴다. 버전별 미리보기 주소는 끈다.
  "workers_dev": true,
  "preview_urls": false,
  // 공개해도 되는 값만 여기에. 비밀값은 `wrangler secret put`으로 넣는다.
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://icmzonndhmqdmqlrmhkn.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_m0R0KuHySG2IaYFopBjfug_SFXnCC2n",
    // 카카오톡 공유 JavaScript 키 (공개 값, ci.yml 배포 env와 같아야 한다)
    "NEXT_PUBLIC_KAKAO_JS_KEY": "b4ca7df9d5307127aa57d4a0b21217e4",
    // 대표 주소 (다른 주소로 들어오면 여기로 영구 이동)
    "SITE_HOST": "www.memories.haedam.app",
    // 가입 봇 방지(Turnstile) 공개 키. 비밀 키 TURNSTILE_SECRET_KEY는 대시보드 비밀값으로만.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFWUeA-1XmoY_KEP",
    // 웹 푸시 공개 키 (브라우저 구독용). 비밀 키 VAPID_PRIVATE_KEY · 푸시 전용 토큰 PUSH_DISPATCH_TOKEN은 비밀값으로만.
    "VAPID_PUBLIC_KEY": "BGcd4_qRdsCQTMEc6dlxWtCeFNW0dFWPdMFtrHUbLDSd_rTmCTbaSk1vIOZfvIDRfek4TcLKfkydo114I1qRttY",
    "PUSH_CONTACT": "asdeasdxz12654@gmail.com"
  },
  "r2_buckets": [
    // 사진(AVIF 마스터 · 변환본). 공개 접근은 끈 상태로 만든다.
    { "binding": "PHOTOS", "bucket_name": "haedam-photos" },
    // DB 백업 전용. 사진 버킷과 분리.
    { "binding": "BACKUPS", "bucket_name": "haedam-backups" }
  ],
  // 사진 열람 속도 제한 (1분). 값은 src/lib/security/image-rate-limit.ts의 IMAGE_LIMITS와 같게.
  "ratelimits": [
    { "name": "IMAGE_ACCOUNT_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "IMAGE_IP_LIMIT", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } }
  ],
  "triggers": {
    // 매일 03:00 KST(18:00 UTC): DB 일시정지 방지 + 백업 상태 확인 / 1분마다: 웹 푸시 (worker.ts PUSH_CRON과 같게)
    "crons": ["0 18 * * *", "* * * * *"]
  }
}
